# Copie para .env e preencha
PORT=3000
# Senha de acesso ao painel /admin (use uma senha forte)
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório longo para assinar a sessão do painel (ex.: saída de `openssl rand -hex 32`)
SESSION_SECRET=
# Pasta onde os leads ficam salvos (precisa ser persistente no servidor)
DATA_DIR=./data
# Use true quando o site estiver em HTTPS
COOKIE_SECURE=false
